# Copy to .env (git-ignored) and fill in the keys you have. One account per person (challenge rule).
# With no keys at all, Cerberus still runs in offline "rules" mode.

# console.groq.com: understand step (GPT-OSS-120B), fast, about 30 requests/min free
GROQ_API_KEY=

# aistudio.google.com: drafts and manual answers (Gemini Flash-Lite), best Arabic of the free options
GEMINI_API_KEY=

# console.mistral.ai: synthetic data generation
MISTRAL_API_KEY=

# openrouter.ai: backup and model comparison
OPENROUTER_API_KEY=

# Ollama needs no key: start the Ollama app and pull the model named in config/providers.yaml
